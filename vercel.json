{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm docs:build",
  "outputDirectory": "docs/dist",
  "redirects": [
    {
      "source": "/security",
      "destination": "/security/overview",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/apis/ui_warning",
      "destination": "/apis/auth_service",
      "permanent": true
    }
  ]
}
