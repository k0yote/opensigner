# Supply-chain hardening for this package.
#
# These live per-package rather than in a root pnpm-workspace.yaml for two
# reasons: a root workspace file is not part of this package's Docker build
# context, so it would never reach `pnpm install` during an image build; and
# declaring a workspace root without listing members orphans the sub-packages,
# making local installs silently no-op.

# Hold off on versions published in the last 24h. A freshly published malicious
# release is the usual shape of an npm account takeover, and this window gives it
# time to be caught before it reaches a build.
minimum-release-age=1440

# Block dependency lifecycle scripts (postinstall etc.) by default.
ignore-scripts=true

# Pin exact versions on install; no silent minor drift on a lockfile refresh.
save-exact=true

# auto-install-peers is intentionally absent. pnpm records it as a resolution
# setting inside the lockfile, so introducing it makes every `--frozen-lockfile`
# install fail until the lockfile is regenerated. Change it only in the same
# commit that regenerates the lockfile.
